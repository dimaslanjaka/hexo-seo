/* ONLY FOR VSCODE */
{
  "ts-node": {
    // Enable ECMAScript module support in ts-node
    "esm": true,
    // Allow experimental resolution of module specifiers
    "experimentalSpecifierResolution": "node",
    "compilerOptions": {
      // Override module configuration for ts-node
      // "module": "ESNext",
      // Disable strict type-checking in ts-node
      "strict": false
    }
  },
  "compilerOptions": {
    "allowJs": true,
    "allowUnusedLabels": true,
    "outDir": "./tmp/dist",
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "declaration": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "checkJs": false,
    "skipLibCheck": true,
    "downlevelIteration": true,
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "ES2015",
      "ESNext"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
  },
  "include": [
    "src",
    "test",
    "rollup.*",
    "gulp*",
    "package-*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/.git/**",
    "**/test/**",
    "**/tmp/**",
    "./package/**/*",
    "./site/**/*",
    "./docs/**/*"
  ]
}