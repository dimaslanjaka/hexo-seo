{
  "name": "hexo-seo",
  "version": "3.0.0",
  "description": "Automated Seo Optimizer For Hexo",
  "main": "dist/src/index.cjs",
  "types": "dist/src/index.d.ts",
  "module": "dist/src/index.mjs",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/index.mjs",
      "require": "./dist/src/index.cjs",
      "types": "./dist/src/index.d.ts"
    },
    "./src/*": {
      "import": "./src/*.ts",
      "require": "./src/*.ts",
      "types": "./src/*.ts"
    }
  },
  "files": [
    "dist/",
    "src/",
    "images/",
    "source/"
  ],
  "scripts": {
    "lint": "eslint ./src",
    "lint-and-fix": "eslint ./src --fix",
    "build:exports": "node --no-warnings=ExperimentalWarning --loader ts-node/esm src/index.builder.ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "node prepare.mjs && npm run build:exports && npm run build:ts && rollup -c && gulp",
    "clean": "npx -y rimraf dist && gulp clean && npm run build",
    "update:project": "curl https://github.com/dimaslanjaka/nodejs-package-types/raw/main/.gitattributes > .gitattributes && curl -L https://github.com/dimaslanjaka/nodejs-package-types/raw/main/changelog.js > changelog.js && curl -L https://github.com/dimaslanjaka/nodejs-package-types/raw/main/packer.js > packer.js",
    "update:ncu": "npx -y npm-check-updates -u -x jsdom,@types/jsdom",
    "update": "npm run update:project && npm run update:ncu",
    "test:generate": "npm run build && cd site && hexo g",
    "test:index": "run-s test:** && node test/index.cjs",
    "pretest": "node pretest.cjs",
    "test": "npx jest --runInBand --forceExit",
    "test:cov": "npm test -- --coverage",
    "test:watch": "npm test -- --watch",
    "prepublish": "npm run prepack",
    "prepack": "node changelog.cjs",
    "pack": "node packer.cjs --yarn",
    "prepare": "husky && node prepare.mjs"
  },
  "repository": "dimaslanjaka/hexo-seo",
  "homepage": "https://www.webmanajemen.com/docs/hexo-seo",
  "keywords": [
    "hexo",
    "hexo plugin",
    "seo",
    "search engine optimization",
    "hexo seo",
    "meta tags",
    "open graph",
    "twitter cards",
    "structured data",
    "sitemap",
    "robots.txt",
    "json-ld",
    "blog seo",
    "content optimization",
    "blogging",
    "hexo site",
    "seo tools",
    "seo automation",
    "web development",
    "page performance",
    "hexo themes"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "hexo": ">=6.3.0"
  },
  "author": {
    "email": "dimaslanjaka@gmail.com",
