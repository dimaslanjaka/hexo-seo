/* FOR BUILD */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowUnusedLabels": true,
    "outDir": "./tmp/dist",
    "resolveJsonModule": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipDefaultLibCheck": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "exclude": [
    "**/node_modules/**",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/.git/**",
    "test",
    "**/*.runner.ts",
    "**/*.builder.ts"
  ],
  "include": [
    "./src/**/*",
    "./source/**/*"
  ]
}